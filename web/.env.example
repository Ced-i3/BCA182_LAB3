# Local development mode (CLOUD_MONITOR_MODE unset). The server reads this
# address; browser code never receives it. Never set it in Vercel production.
BACKEND_URL=http://127.0.0.1:5000

# Cloud mode values for Vercel after explicit approval. The publishable key is
# safe to expose; RLS and server-side session checks protect private rows.
# CLOUD_MONITOR_MODE=cloud
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
# CLOUD_INGEST_TOKEN_HASHES={"rt-spark-001":"replace_with_64_lowercase_sha256_hex_chars"}
