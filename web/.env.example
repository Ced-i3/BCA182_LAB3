# Local development mode (CLOUD_MONITOR_MODE unset). The server reads this
# address; browser code never receives it. Never set it in Vercel production.
BACKEND_URL=http://127.0.0.1:5000

# Temporary public demo mode. Only the fixed rt-spark-001 monitoring snapshot is
# public. Keep the Supabase secret and ingest hash server-side in Vercel.
# CLOUD_MONITOR_MODE=cloud
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
# CLOUD_INGEST_TOKEN_HASHES={"rt-spark-001":"replace_with_64_lowercase_sha256_hex_chars"}
