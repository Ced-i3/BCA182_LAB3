+#include <icm20608.h>
+
+#include "motion_mqtt.h"
+
+/* One place for selected ICM20608 ranges, scale factors, and warning levels. */
+#define ICM20608_ACCEL_RANGE             ICM20608_ACCELEROMETER_RANGE1
+#define ICM20608_ACCEL_FULL_SCALE_G      4
+#define ICM20608_ACCEL_LSB_PER_G          8192
+#define ICM20608_GYRO_RANGE               ICM20608_GYROSCOPE_RANGE1
+#define ICM20608_GYRO_FULL_SCALE_DPS      500
+#define ICM20608_GYRO_SENSITIVITY_NUM     655
+#define ICM20608_GYRO_SENSITIVITY_DEN     10
+#define ICM20608_SATURATION_WARN_PERCENT  90
+#define ICM20608_SATURATION_CLEAR_PERCENT 85
+#define OUTPUT_MILLI_SCALE                1000
+#define OUTPUT_CENTI_SCALE                100
+#define ICM20608_SAMPLE_RATE_HZ            25U
+#define ICM20608_SAMPLE_PERIOD_TICKS       (RT_TICK_PER_SECOND / ICM20608_SAMPLE_RATE_HZ)
+#define ICM20608_DIAGNOSTIC_INTERVAL_TICKS RT_TICK_PER_SECOND
+
+#if (ICM20608_SAMPLE_RATE_HZ == 0) || (ICM20608_SAMPLE_RATE_HZ > RT_TICK_PER_SECOND)
+#error "ICM20608 sample rate must map to at least one RT-Thread tick"
 #endif
 
+#define ICM20608_ACCEL_WARN_COUNTS \
+    ((ICM20608_ACCEL_FULL_SCALE_G * ICM20608_ACCEL_LSB_PER_G * ICM20608_SATURATION_WARN_PERCENT) / 100)
+#define ICM20608_GYRO_WARN_COUNTS \
+    ((ICM20608_GYRO_FULL_SCALE_DPS * ICM20608_GYRO_SENSITIVITY_NUM * ICM20608_SATURATION_WARN_PERCENT) / \
+     (ICM20608_GYRO_SENSITIVITY_DEN * 100))
+#define ICM20608_ACCEL_CLEAR_COUNTS \
+    ((ICM20608_ACCEL_FULL_SCALE_G * ICM20608_ACCEL_LSB_PER_G * ICM20608_SATURATION_CLEAR_PERCENT) / 100)
+#define ICM20608_GYRO_CLEAR_COUNTS \
+    ((ICM20608_GYRO_FULL_SCALE_DPS * ICM20608_GYRO_SENSITIVITY_NUM * ICM20608_SATURATION_CLEAR_PERCENT) / \
+     (ICM20608_GYRO_SENSITIVITY_DEN * 100))
+
+static rt_uint8_t saturation_warning_mask;
+
+static void report_sampling_diagnostics(rt_tick_t now, rt_tick_t *window_start,
+                                        rt_uint32_t *cycles, rt_uint32_t *valid_samples,
+                                        rt_uint32_t *missed_deadlines, rt_uint32_t *i2c_errors)
+{
+    rt_tick_t elapsed = now - *window_start;
+
+    if (elapsed >= ICM20608_DIAGNOSTIC_INTERVAL_TICKS)
+    {
+        rt_uint32_t cycle_rate_tenths =
+            (rt_uint32_t)(((rt_uint64_t)*cycles * RT_TICK_PER_SECOND * 10U) / elapsed);
+        rt_uint32_t valid_rate_tenths =
+            (rt_uint32_t)(((rt_uint64_t)*valid_samples * RT_TICK_PER_SECOND * 10U) / elapsed);
+
+        rt_kprintf("Sampling: cycles=%u.%u Hz valid=%u.%u Hz missed=%u I2C_errors=%u\r\n",
+                   (unsigned int)(cycle_rate_tenths / 10U),
+                   (unsigned int)(cycle_rate_tenths % 10U),
+                   (unsigned int)(valid_rate_tenths / 10U),
+                   (unsigned int)(valid_rate_tenths % 10U),
+                   (unsigned int)*missed_deadlines, (unsigned int)*i2c_errors);
+
+        *window_start = now;
+        *cycles = 0;
+        *valid_samples = 0;
+        *missed_deadlines = 0;
+        *i2c_errors = 0;
+    }
+}
+
+static rt_int32_t accel_to_milli_g(rt_int16_t raw)
+{
+    rt_int32_t scaled = (rt_int32_t)raw * OUTPUT_MILLI_SCALE;
+
+    scaled += (scaled >= 0) ? (ICM20608_ACCEL_LSB_PER_G / 2) : -(ICM20608_ACCEL_LSB_PER_G / 2);
+    return scaled / ICM20608_ACCEL_LSB_PER_G;
+}
+
+static rt_int32_t gyro_to_centi_dps(rt_int16_t raw)
+{
+    rt_int32_t scaled = (rt_int32_t)raw * OUTPUT_CENTI_SCALE * ICM20608_GYRO_SENSITIVITY_DEN;
+
+    scaled += (scaled >= 0) ? (ICM20608_GYRO_SENSITIVITY_NUM / 2) : -(ICM20608_GYRO_SENSITIVITY_NUM / 2);
+    return scaled / ICM20608_GYRO_SENSITIVITY_NUM;
+}
+
+static void print_milli_g(rt_int32_t value)
+{
+    rt_uint32_t magnitude = (rt_uint32_t)(value < 0 ? -value : value);
+
+    rt_kprintf("%s%u.%03u", value < 0 ? "-" : "",
+               (unsigned int)(magnitude / OUTPUT_MILLI_SCALE),
+               (unsigned int)(magnitude % OUTPUT_MILLI_SCALE));
+}
+
+static void print_centi_dps(rt_int32_t value)
+{
+    rt_uint32_t magnitude = (rt_uint32_t)(value < 0 ? -value : value);
+
+    rt_kprintf("%s%u.%02u", value < 0 ? "-" : "",
+               (unsigned int)(magnitude / OUTPUT_CENTI_SCALE),
+               (unsigned int)(magnitude % OUTPUT_CENTI_SCALE));
+}
+
+static void check_axis_saturation(rt_int16_t raw, rt_uint8_t axis_bit,
+                                  rt_int32_t warn_counts, rt_int32_t clear_counts,
+                                  const char *sensor_name, char axis_name)
+{
+    rt_int32_t magnitude = (raw < 0) ? -(rt_int32_t)raw : (rt_int32_t)raw;
+    rt_uint8_t mask = (rt_uint8_t)(1U << axis_bit);
+
+    if (magnitude >= warn_counts)
+    {
+        if ((saturation_warning_mask & mask) == 0)
+        {
+            rt_kprintf("WARNING: %s %c axis near full scale (%d counts; threshold %d).\r\n",
+                       sensor_name, axis_name, raw, (int)warn_counts);
+            saturation_warning_mask |= mask;
+        }
+    }
+    else if (magnitude < clear_counts)
+    {
+        saturation_warning_mask &= (rt_uint8_t)~mask;
+    }
+}
+
+static rt_err_t configure_and_verify_ranges(icm20608_device_t sensor)
+{
+    rt_uint8_t accel_range;
+    rt_uint8_t gyro_range;
+    rt_err_t result;
+
+    result = icm20608_set_param(sensor, ICM20608_ACCEL_CONFIG1, ICM20608_ACCEL_RANGE);
+    if (result != RT_EOK)
+    {
+        rt_kprintf("ERROR: Failed to write ICM20608 accelerometer range (%d).\r\n", result);
+        return result;
+    }
+
+    result = icm20608_set_param(sensor, ICM20608_GYRO_CONFIG, ICM20608_GYRO_RANGE);
+    if (result != RT_EOK)
+    {
+        rt_kprintf("ERROR: Failed to write ICM20608 gyroscope range (%d).\r\n", result);
+        return result;
+    }
+
+    result = icm20608_get_param(sensor, ICM20608_ACCEL_CONFIG1, &accel_range);
+    if (result != RT_EOK)
+    {
+        rt_kprintf("ERROR: Failed to read back ICM20608 accelerometer range (%d).\r\n", result);
+        return result;
+    }
+
+    result = icm20608_get_param(sensor, ICM20608_GYRO_CONFIG, &gyro_range);
+    if (result != RT_EOK)
+    {
+        rt_kprintf("ERROR: Failed to read back ICM20608 gyroscope range (%d).\r\n", result);
+        return result;
+    }
+
+    if ((accel_range != ICM20608_ACCEL_RANGE) || (gyro_range != ICM20608_GYRO_RANGE))
+    {
+        rt_kprintf("ERROR: ICM20608 range readback mismatch (accel=%u gyro=%u).\r\n",
+                   (unsigned int)accel_range, (unsigned int)gyro_range);
+        return -RT_ERROR;
+    }
+
+    return RT_EOK;
+}
