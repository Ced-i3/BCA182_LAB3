diff --git a/icm20608.c b/icm20608.c
index cbb536d..47da30b 100644
--- a/icm20608.c
+++ b/icm20608.c
@@ -35,6 +35,8 @@
 #define ICM20608_GYRO_MEAS 0x43         // gyroscope measurements
 #define ICM20608_PWR_MGMT1_REG 0x6B     // power management 1
 #define ICM20608_PWR_MGMT2_REG 0x6C     // power management 2
+#define ICM20608_WHO_AM_I_REG 0x75     // device identity
+#define ICM20608_WHO_AM_I_VALUE 0xAF   // ICM-20608-G identity
 
 #define ICM20608_ADDR 0x68 /* slave address, ad0 set 0 */
 
@@ -110,12 +112,28 @@ static rt_err_t reset_sensor(icm20608_device_t dev)
 static rt_err_t icm20608_sensor_init(icm20608_device_t dev)
 {
     rt_err_t result = -RT_ERROR;
+    rt_uint8_t identity;
 
     RT_ASSERT(dev);
 
     result = rt_mutex_take(dev->lock, RT_WAITING_FOREVER);
     if (result != RT_EOK)
     {
+        LOG_E("Can't take mutex while initializing sensor");
+        return result;
+    }
+
+    result = read_regs(dev->i2c, ICM20608_WHO_AM_I_REG, 1, &identity);
+    if (result != RT_EOK)
+    {
+        LOG_E("Can't read ICM20608 WHO_AM_I register");
+        goto __exit;
+    }
+    if (identity != ICM20608_WHO_AM_I_VALUE)
+    {
+        LOG_E("Unexpected ICM20608 identity: 0x%02x (expected 0x%02x)",
+              identity, ICM20608_WHO_AM_I_VALUE);
+        result = -RT_ERROR;
         goto __exit;
     }
 
@@ -178,12 +196,20 @@ rt_err_t icm20608_calib_level(icm20608_device_t dev, rt_size_t times)
     rt_int32_t gyro[3] = {0, 0, 0};
     rt_size_t i;
     rt_err_t result;
+    rt_bool_t lock_acquired = RT_FALSE;
 
     RT_ASSERT(dev);
 
+    if (times == 0)
+    {
+        LOG_E("Calibration sample count must be greater than zero");
+        return -RT_ERROR;
+    }
+
     result = rt_mutex_take(dev->lock, RT_WAITING_FOREVER);
     if (result == RT_EOK)
     {
+        lock_acquired = RT_TRUE;
         for (i = 0; i < times; i++)
         {
             rt_int16_t x, y, z;
@@ -226,11 +252,12 @@ rt_err_t icm20608_calib_level(icm20608_device_t dev, rt_size_t times)
         }
     }
 
-    if (result == RT_EOK)
+    if (lock_acquired)
     {
         rt_mutex_release(dev->lock);
     }
-    else
+
+    if (result != RT_EOK)
     {
         LOG_E("Can't calibrate the sensor");
     }
@@ -255,8 +282,6 @@ icm20608_device_t icm20608_init(const char *i2c_bus_name)
     if (dev == RT_NULL)
     {
         LOG_E("Can't allocate memory for icm20608 device on '%s' ", i2c_bus_name);
-        rt_free(dev);
-
         return RT_NULL;
     }
 
@@ -283,8 +308,8 @@ icm20608_device_t icm20608_init(const char *i2c_bus_name)
     if (icm20608_sensor_init(dev) != RT_EOK)
     {
         LOG_E("Can't init icm20608 device on '%s'", i2c_bus_name);
-        rt_free(dev);
         rt_mutex_delete(dev->lock);
+        rt_free(dev);
 
         return RT_NULL;
     }
