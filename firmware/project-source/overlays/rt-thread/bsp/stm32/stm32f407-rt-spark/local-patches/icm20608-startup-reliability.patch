diff --git a/icm20608.c b/icm20608.c
--- a/icm20608.c
+++ b/icm20608.c
@@ -37,6 +37,9 @@
 #define ICM20608_PWR_MGMT2_REG 0x6C     // power management 2
 #define ICM20608_WHO_AM_I_REG 0x75     // device identity
 #define ICM20608_WHO_AM_I_VALUE 0xAF   // ICM-20608-G identity
+/* Datasheet allows up to 100 ms from power-up before register access is ready. */
+#define ICM20608_WHO_AM_I_RETRY_COUNT 3
+#define ICM20608_WHO_AM_I_RETRY_DELAY_MS 50
 
 #define ICM20608_ADDR 0x68 /* slave address, ad0 set 0 */
 
@@ -113,6 +116,7 @@
 {
     rt_err_t result = -RT_ERROR;
     rt_uint8_t identity;
+    rt_uint8_t attempt;
 
     RT_ASSERT(dev);
 
@@ -123,10 +127,36 @@
         return result;
     }
 
-    result = read_regs(dev->i2c, ICM20608_WHO_AM_I_REG, 1, &identity);
-    if (result != RT_EOK)
-    {
-        LOG_E("Can't read ICM20608 WHO_AM_I register");
+    for (attempt = 0; attempt < ICM20608_WHO_AM_I_RETRY_COUNT; attempt++)
+    {
+        result = read_regs(dev->i2c, ICM20608_WHO_AM_I_REG, 1, &identity);
+        if ((result == RT_EOK) && (identity == ICM20608_WHO_AM_I_VALUE))
+        {
+            break;
+        }
+
+        if (attempt + 1 < ICM20608_WHO_AM_I_RETRY_COUNT)
+        {
+            if (result != RT_EOK)
+            {
+                LOG_W("WHO_AM_I I2C read failed on attempt %u/%u; retrying in %u ms",
+                      (unsigned int)attempt + 1U, (unsigned int)ICM20608_WHO_AM_I_RETRY_COUNT,
+                      (unsigned int)ICM20608_WHO_AM_I_RETRY_DELAY_MS);
+            }
+            else
+            {
+                LOG_W("Unexpected WHO_AM_I 0x%02x on attempt %u/%u; retrying",
+                      identity, (unsigned int)attempt + 1U, (unsigned int)ICM20608_WHO_AM_I_RETRY_COUNT);
+            }
+
+            rt_thread_mdelay(ICM20608_WHO_AM_I_RETRY_DELAY_MS);
+        }
+    }
+
+    if (result != RT_EOK)
+    {
+        LOG_E("Can't read ICM20608 WHO_AM_I register after %u attempts",
+              (unsigned int)ICM20608_WHO_AM_I_RETRY_COUNT);
         goto __exit;
     }
     if (identity != ICM20608_WHO_AM_I_VALUE)
@@ -295,7 +325,7 @@
         return RT_NULL;
     }
 
-    dev->lock = rt_mutex_create("mutex_icm20608", RT_IPC_FLAG_FIFO);
+    dev->lock = rt_mutex_create("icm20608", RT_IPC_FLAG_FIFO);
     if (dev->lock == RT_NULL)
     {
         LOG_E("Can't create mutex for icm20608 device on '%s'", i2c_bus_name);
