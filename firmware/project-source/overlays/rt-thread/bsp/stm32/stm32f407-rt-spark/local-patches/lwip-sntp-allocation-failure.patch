--- a/components/net/lwip/lwip-2.0.3/src/apps/sntp/sntp.c
+++ b/components/net/lwip/lwip-2.0.3/src/apps/sntp/sntp.c
@@ -546,19 +546,20 @@ sntp_init(void)
   if (sntp_pcb == NULL) {
     sntp_pcb = udp_new_ip_type(IPADDR_TYPE_ANY);
-    LWIP_ASSERT("Failed to allocate udp pcb for sntp client", sntp_pcb != NULL);
-    if (sntp_pcb != NULL) {
+    if (sntp_pcb == NULL) {
+      LWIP_DEBUGF(SNTP_DEBUG_SERIOUS, ("sntp_init: unable to allocate UDP PCB\n"));
+    } else {
       udp_recv(sntp_pcb, sntp_recv, NULL);
 
       if (sntp_opmode == SNTP_OPMODE_POLL) {
         SNTP_RESET_RETRY_TIMEOUT();
 #if SNTP_STARTUP_DELAY
         sys_timeout((u32_t)SNTP_STARTUP_DELAY_FUNC, sntp_request, NULL);
 #else
         sntp_request(NULL);
 #endif
       } else if (sntp_opmode == SNTP_OPMODE_LISTENONLY) {
         ip_set_option(sntp_pcb, SOF_BROADCAST);
         udp_bind(sntp_pcb, IP_ANY_TYPE, SNTP_PORT);
       }
     }
   }
