+static void rw007_secure_zero(void *data, rt_size_t length)
+{
+    volatile rt_uint8_t *byte = (volatile rt_uint8_t *)data;
+
+    while (length--)
+    {
+        *byte++ = 0;
+    }
+}
+
+/* Join and SoftAP command packets are the only queued SPI payloads that
+ * contain credentials. */
+static rt_bool_t rw007_packet_contains_credentials(struct spi_data_packet *packet)
+{
+    struct rw007_cmd *cmd;
+    rt_size_t value_offset = member_offset(struct rw007_cmd, value);
+
+    if (packet == RT_NULL || packet->data_type != DATA_TYPE_CMD || packet->data_len < value_offset)
+    {
+        return RT_FALSE;
+    }
+
+    cmd = (struct rw007_cmd *)packet->buffer;
+    return (cmd->cmd == RW00x_CMD_JOIN || cmd->cmd == RW00x_CMD_SOFTAP) ? RT_TRUE : RT_FALSE;
+}
+
+/* Clear credentials before returning their TX packet to the memory pool. */
+static void rw007_clear_sensitive_packet(struct spi_data_packet *packet)
+{
+    struct rw007_cmd *cmd;
+    rt_size_t payload_length;
+    rt_size_t available_length;
+
+    if (rw007_packet_contains_credentials(packet))
+    {
+        cmd = (struct rw007_cmd *)packet->buffer;
+        payload_length = cmd->len;
+        available_length = packet->data_len - member_offset(struct rw007_cmd, value);
+        if (payload_length > available_length)
+        {
+            payload_length = available_length;
+        }
+        if (payload_length > SPI_MAX_DATA_LEN - member_offset(struct rw007_cmd, value))
+        {
+            payload_length = SPI_MAX_DATA_LEN - member_offset(struct rw007_cmd, value);
+        }
+        rw007_secure_zero(&cmd->value, payload_length);
+    }
+}
+
