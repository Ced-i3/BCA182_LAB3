# Copy to a private environment file and load it into the sync worker's process.
# Generate a unique random token of at least 32 bytes; never reuse an account key.
CLOUD_INGEST_URL=https://your-vercel-domain.example/api/cloud/ingest
CLOUD_INGEST_TOKEN=replace-with-a-private-random-url-safe-token
CLOUD_DEVICE_ID=rt-spark-001
CLOUD_SYNC_INTERVAL_SECONDS=5
CLOUD_SYNC_BATCH_SIZE=25
# Optional: defaults to data/motion.db and data/cloud_sync.db.
# MOTION_DB_PATH=...
# CLOUD_SYNC_STATE_PATH=...
