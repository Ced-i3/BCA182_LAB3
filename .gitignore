# Python environments, bytecode, test and analysis caches
**/.venv/
**/.venv*/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/coverage.xml
*.py[cod]
*.egg-info/
**/.tmp/

# Local credentials and environment-specific settings
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
web/.env.local
web/.env.*.local

# Laptop-specific anonymous broker configuration; keep the sample instead
/backend/broker.yaml

# Local runtime data and logs; keep the source dataset local.
/backend/data/*.db
/backend/data/*.db-*
/backend/data/*.sqlite
/backend/data/*.sqlite-*
/backend/data/*.sqlite3
/backend/data/*.sqlite3-*
/backend/logs/
# Dataset license/redistribution terms have not been verified; keep it local.
/backend/data/archive/dataset.csv
# Project owner authorized redistribution of the corrected trained artifact.
# Keep older/other serialized models out of the public baseline.
/backend/models/*.joblib
!/backend/models/activity_model_corrected.joblib
# Empty local artifact; not part of the backend application.
/backend/file
*.log
*.log.*

# Next.js generated files and installed dependencies
/web/node_modules/
/web/.next/
/web/out/
/web/.vercel/
/web/.npm-cache/
/web/*.tsbuildinfo
# Generated by Next.js from the installed version and build output.
/web/next-env.d.ts

# Embedded build outputs and tool caches. Keep configuration and source files.
**/.sconsign.dblite
**/*.o
**/*.obj
**/*.a
**/*.elf
**/*.axf
**/*.map
**/*.hex
**/*.bin
**/build/
**/Debug/
**/Release/
**/Listings/
**/Objects/
**/*.dep
**/*.su
**/*.crf
**/*.d
**/*.ilk
**/*.pdb
**/*.idb
**/*.old

# Local archives/tool installers already retained in this working copy
/android-source-backup-*.zip
/env-windows-v*.7z

# Course-provided assignment document; confirm redistribution rights first.
/BCA180 ESP - Laboratory Activity 3.pdf

# Redundant local clone; the BSP contains the integrated, licensed package.
/rw007-download/
# Local known-working upstream checkout and isolated verification workspace.
# Publish firmware/project-source/ instead.
/firmware/rt-thread/
/firmware/reconstruction-work/
# Isolated fresh-clone verification workspace (never publication source).
/publication-check/

# Operating system and IDE-generated files
.DS_Store
Thumbs.db
Desktop.ini
**/.idea/
**/.vs/
**/*.suo
**/*.user
**/*.code-workspace
